# Copy this file to .env and fill in the token.
# Get one from https://discord.com/developers/applications -> your app -> Bot -> Reset Token.

# Required. The bot will not start without it.
DISCORD_TOKEN=

# Optional. A server ID: commands are synced to that guild instantly instead of
# waiting on Discord's global sync (which can take an hour). Handy while developing.
# DEV_GUILD_ID=

# Optional. Where timers are kept between restarts.
# DB_PATH=data/timers.db

# Optional. A preset JSON file to use instead of the bundled data/presets.json.
# PRESETS_FILE=my-presets.json

# Optional. How often the bot checks for due timers, in seconds.
# TICK_SECONDS=5

# Optional. A timer that fires more than this many seconds late says so in its alert.
# MISSED_AFTER_SECONDS=120

# Optional. Cap on timers per server.
# MAX_TIMERS_PER_GUILD=100

# Optional. DEBUG, INFO, WARNING, ERROR.
# LOG_LEVEL=INFO
